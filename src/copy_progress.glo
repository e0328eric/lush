//! Report copy progress on the caller's thread for the shell and browser.
#import "File_System/Copy";
#import "File_System/Types";
#import "File_System/Walk";
#import "File_System/Metadata";
#import "File_System/Path";
#import "Container/HashMap";
#import "Container/Hash";
#import "Strings/Utf8";
#import "Format";
#import "Thread";
#import "Context";
#if OUT.os == .Windows {
    Windows_Tree :: #import "windows_tree_copy.glo";
    Metrics :: #import "windows_copy_metrics.glo";
}

#public {
Progress :: #fn_ptr(state: *void, completed: s64, total: s64, entries: s64);

error_message :: (error: Fs_Error) -> str {
    if error.kind == .Already_Exists && error.operation == .Change_Mode {
        detail := ifx error.os_code == 0 "" else tprint(" (Windows error {})", error.os_code);
        return tprint("copy needs a case-sensitive destination for '{}' and '{}'{}", error.path, error.other_path, detail);
    }
    if error.other_path.count > 0 return tprint("{} -> {}: {} (os {})",
        error.path, error.other_path, error.kind.reason(), error.os_code);
    return tprint("{}: {} (os {})", error.path, error.kind.reason(), error.os_code);
}
}

// Only a file larger than the native write buffer needs partial-byte samples.
COPY_BUFFER_SIZE :: 1_048_576;
MAX_BYTES :: 16#7fff_ffff_ffff_ffff;

Large_File :: struct {
    source: str;
    destination: str;
    size: s64;
    original_size: s64 = -1;
    completed: Atomic(bool);
}

Copy_Job :: struct {
    source: str;
    destination: str;
    policy: Copy_Policy;
    directory: bool;
    notify: Progress;
    state: *void;
    total: s64;
    scanned: s64;
    entries: Atomic(s64);
    files: [..]Large_File;
    by_source: HashMap(str, ssize);
    confirmed: Atomic(s64);
    finished: Atomic(bool);
    result: Fs_Error!s64;
}

native_copy :: (source: str, destination: str, directory: bool, policy: Copy_Policy,
    observer: Copy_Observer = .{}) -> Fs_Error!s64 {
    if directory return .Ok(cast(s64) copy_tree(source, destination, policy, .observer = observer)?);
    return copy_file(source, destination, policy);
}

watch_file :: (job: *Copy_Job, source: str, destination: str, size: s64) {
    file := Large_File.{ .source = source.clone(), .destination = destination.clone(), .size = size };
    if job.policy == .Overwrite {
        if #pattern .Ok(previous) = metadata(destination, false) {
            if previous.kind == .Regular file.original_size = previous.size;
        }
    }
    _ := job.by_source.insert(file.source, job.files.count);
    job.files.push(file);
}

count_bytes :: (job: *Copy_Job, path: str, entry: Directory_Entry, depth: ssize) -> Walk_Control {
    job.scanned += 1;
    job.notify(job.state, job.scanned, -1, -1);
    if entry.kind != .Regular return .Continue;
    #temp_scope {
        #pattern .Ok(info) := metadata(path, false) else { job.total = -1; return .Stop; };
        if info.size < 0 || info.size > MAX_BYTES - job.total { job.total = -1; return .Stop; }
        job.total += info.size;
        if info.size > COPY_BUFFER_SIZE {
            #pattern .Ok(relative) := path_lexically_relative(path, job.source, .allocator = context.temp_allocator)
                else { return .Continue; };
            // Windows trees use the parallel copier. Keep symlink/.. in a
            // POSIX destination prefix intact when sampling a large child.
            target := tprint("{}/{}", job.destination, relative);
            watch_file(job, path, target, info.size);
        }
    }
    return .Continue;
}

// The stdlib notifies on the copying thread after completing each object.
// Count only the data in regular files, including overwritten files.
entry_copied :: (pointer: ?*void, source: str, destination: str, completed: ssize) {
    #pattern ?value := pointer else { return; };
    job := cast(*Copy_Job) value;
    job.entries.store(completed);
    if #pattern ?index = job.by_source.get(source) job.files[index.*].completed.store(true);
    #temp_scope {
        if #pattern .Ok(info) = metadata(destination, false) {
            if info.kind == .Regular && info.size > 0 {
                previous := job.confirmed.load();
                if info.size <= MAX_BYTES - previous job.confirmed.store(previous + info.size);
            }
        }
    }
}

// A filesystem diagnostic can borrow a temporary path on its worker thread.
keep_error :: (error: Fs_Error) -> Fs_Error {
    return error.with_path(error.path.clone(heap_allocator()), error.other_path.clone(heap_allocator()));
}

take_result :: (result: Fs_Error!s64) -> Fs_Error!s64 {
    if #pattern .Err(error) = result {
        defer error.path.free(heap_allocator());
        defer error.other_path.free(heap_allocator());
        return .Err(error.with_path(error.path.clone(context.temp_allocator).into_temporary(),
            error.other_path.clone(context.temp_allocator).into_temporary()));
    }
    return result;
}

copy_on_worker :: (pointer: *void) -> ?*void #c_call {
    job := cast(*Copy_Job) pointer;
    #temp_scope {
        observer := Copy_Observer.{ .state = ?pointer, .progress = ?entry_copied, .child_errors = true };
        job.result = native_copy(job.source, job.destination, job.directory, job.policy, observer);
        if #pattern .Err(error) = job.result job.result = .Err(keep_error(error));
    }
    job.finished.store(true);
    return null;
}

partial_size :: (file: *Large_File) -> s64 {
    if file.completed.load() return 0;
    if #pattern .Ok(info) = metadata(file.destination, false) {
        if info.kind == .Regular && info.size != file.original_size {
            // An existing file's length becomes meaningful after truncation.
            file.original_size = -1;
            if info.size > 0 && info.size < file.size return info.size;
        }
    }
    return 0;
}

Sample :: struct { remaining: ssize; active: ssize = -1; cursor: ssize; }

sample_partial :: (job: *Copy_Job, sample: *Sample) -> s64 {
    // The native copy takes directory children off a stack. Its next large
    // file is normally the last uncompleted one in the depth-first walk.
    while sample.remaining > 0 && job.files[sample.remaining - 1].completed.load() sample.remaining -= 1;
    if sample.remaining == 0 return 0;
    if sample.active >= 0 && sample.active < sample.remaining {
        bytes := partial_size(&job.files[sample.active]);
        if bytes > 0 return bytes;
    }
    sample.active = sample.remaining - 1;
    bytes := partial_size(&job.files[sample.active]);
    if bytes > 0 return bytes;
    // Enumeration can change between passes. Probe a bounded window of
    // other candidates and remember a partial file once we find it.
    probes := ifx sample.remaining > 4 4 else sample.remaining - 1;
    for i: 0..probes {
        if sample.cursor <= 0 || sample.cursor >= sample.remaining sample.cursor = sample.remaining - 1;
        sample.cursor -= 1;
        bytes = partial_size(&job.files[sample.cursor]);
        if bytes > 0 { sample.active = sample.cursor; return bytes; }
    }
    return 0;
}

#public {
// A negative total distinguishes scanning (-1), transferred bytes while
// sizing (-2), and completed entries in a tree with no measurable bytes (-3).
copy :: (source: str, destination: str, info: Metadata, policy: Copy_Policy,
    notify: ?Progress, state: *void) -> Fs_Error!s64 {
    directory := info.kind == .Directory;
    #if OUT.os == .Windows {
        if directory return copy_windows_tree(source, destination, info, policy, notify, state);
    }
    #pattern ?update := notify else { return native_copy(source, destination, directory, policy); };
    if !directory && (info.kind != .Regular || info.size <= COPY_BUFFER_SIZE) {
        update(state, 0, info.size, -1);
        return copy_file(source, destination, policy);
    }
    if policy == .Fail_If_Exists && metadata(destination, false).is_ok()
        return native_copy(source, destination, directory, policy);

    job := Copy_Job.{ .source = source, .destination = destination, .policy = policy,
        .directory = directory, .notify = update, .state = state };
    defer {
        job.by_source.free();
        for *file: job.files { file.source.free(); file.destination.free(); }
        job.files.free();
    }
    if directory {
        update(state, 0, -1, -1);
        if walk_context(source, &job, count_bytes).is_err() job.total = -1;
    } else {
        job.total = info.size;
        watch_file(&job, source, destination, info.size);
    }
    update(state, 0, job.total, -1);
    #pattern .Ok(thread) := Thread.spawn(copy_on_worker, &job)
        else { return native_copy(source, destination, directory, policy); };
    sample := Sample.{ .remaining = job.files.count };
    shown: s64;
    delay: s64 = 1;
    while !job.finished.load() {
        #temp_scope {
            confirmed := job.confirmed.load();
            partial := sample_partial(&job, &sample);
            // A file may finish during the metadata probe. Credit its
            // confirmed size only once, and keep displayed bytes monotonic.
            current := job.confirmed.load();
            if current == confirmed && partial <= MAX_BYTES - current current += partial;
            if current > shown shown = current;
            entries := ifx directory job.entries.load() else -1;
            if job.total == 0 update(state, entries, -3, entries);
            else if job.total < 0 update(state, shown, -2, entries);
            else update(state, shown, job.total, entries);
        }
        sleep_ms(delay);
        if delay < 32 delay *= 2;
    }
    _ := thread.join();
    return take_result(job.result);
}
}

#if OUT.os == .Windows {
    Windows_Job :: struct {
        source: str;
        destination: str;
        info: Metadata;
        policy: Copy_Policy;
        entries: Atomic(s64);
        bytes: Atomic(s64);
        scanned: Atomic(s64);
        total: Atomic(s64);
        finished: Atomic(bool);
        result: Fs_Error!s64;
    }

    scan_windows_tree :: (pointer: *void) -> ?*void #c_call {
        job := cast(*Windows_Job) pointer;
        job.total.store(Metrics.tree_size(job.source, &job.finished, &job.scanned));
        return null;
    }

    windows_entry :: (pointer: ?*void, source: str, destination: str, completed: ssize) {
        if #pattern ?value = pointer {
            job := cast(*Windows_Job) value;
            job.entries.store(completed);
        }
    }

    run_windows_tree :: (pointer: *void) -> ?*void #c_call {
        job := cast(*Windows_Job) pointer;
        #temp_scope {
            observer := Copy_Observer.{ .state = ?pointer, .progress = ?windows_entry, .child_errors = true };
            if Windows_Tree.copy(job.source, job.destination, job.info, job.policy, observer, ?&job.bytes) == {
            case .Ok(count); job.result = .Ok(cast(s64) count);
            case .Err(error); job.result = .Err(keep_error(error));
            }
        }
        job.finished.store(true);
        return null;
    }

    copy_windows_tree :: (source: str, destination: str, info: Metadata, policy: Copy_Policy,
        notify: ?Progress, state: *void) -> Fs_Error!s64 {
        #pattern ?update := notify else {
            return .Ok(cast(s64) Windows_Tree.copy(source, destination, info, policy, .{ .child_errors = true })?);
        };
        job := Windows_Job.{ .source = source, .destination = destination, .info = info, .policy = policy };
        job.total.store(-1);
        baseline := Metrics.io_sample();
        #pattern .Ok(worker) := Thread.spawn(run_windows_tree, &job) else {
            return .Ok(cast(s64) Windows_Tree.copy(source, destination, info, policy, .{ .child_errors = true })?);
        };
        // Counting available bytes is optional. Start the transfer first and
        // stop the inventory immediately on a copy failure or early completion.
        scanner := Thread.spawn(scan_windows_tree, &job);
        delay: s64 = 1;
        while !job.finished.load() {
            total := job.total.load();
            entries := job.entries.load();
            bytes := job.bytes.load();
            in_flight := Metrics.transferred(baseline, Metrics.io_sample());
            if in_flight > bytes bytes = in_flight;
            if total > 0 {
                if bytes > total bytes = total;
                update(state, bytes, total, entries);
            } else if bytes > 0 && total != 0 update(state, bytes, -2, entries);
            else if entries > 0 || total == 0 update(state, entries, -3, entries);
            else update(state, job.scanned.load(), -1, -1);
            sleep_ms(delay);
            if delay < 32 delay *= 2;
        }
        _ := worker.join();
        if #pattern .Ok(thread) = scanner _ := thread.join();
        return take_result(job.result);
    }
}

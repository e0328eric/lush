//! Embedded fls: upstream views plus records with the same filtering/sorting.
#import "Io";
#import "Format";
#import "Strings/Utf8";
#import "Context";
#import "Memory/Ownership";
#import "Terminal";
#import "File_System/File";
#import "File_System/System";
#import "../vendor/fls/src/directory_size.glo";
Options :: #import "../vendor/fls/src/options.glo";
Cli :: #import "../vendor/fls/src/cli.glo";
Entries :: #import "../vendor/fls/src/entry.glo";
Theme :: #import "../vendor/fls/src/theme.glo";
Git :: #import "../vendor/fls/src/git.glo";
Util :: #import "../vendor/fls/src/util.glo";
Tui :: #import "../vendor/fls/src/tui.glo";
Lol :: #import "../vendor/fls/src/lol.glo";

reset_globals :: () {
    Theme.reset_theme();
    Git.reset_git();
    Util.reset_util();
}

has_flag :: (args: []const str, prefix: str) -> bool {
    for arg: args if arg.starts_with(prefix) return true;
    return false;
}

valid_arguments :: (args: []const str) -> bool {
    for arg: args if arg.has_nul() return false;
    return true;
}

#public {

// Arguments exclude an executable name, exactly as ls("-l", "path").
run :: (args: []const str) -> s32 {
    // Native filesystem calls use the thread's temp arena for path conversions.
    // Share it with formatting so each frame can release both at its own mark.
    mark := temp_mark();
    defer temp_rewind(mark);
    previous_scratch := context.temp_allocator;
    context.temp_allocator = default_temp_allocator();
    defer context.temp_allocator = previous_scratch;
    defer reset_globals();
    options: Options.Options;
    defer Options.free_options(&options);
    parsed := Options.parse_options(args, &options);
    if !valid_arguments(args) || !parsed.ok {
        message := ifx valid_arguments(args) parsed.message else "arguments cannot contain NUL bytes";
        stderr := File.stderr();
        _ := stderr.writef("fls: {}\nTry 'fls --help' for more information.\n", message);
        return 3;
    }
    if options.help { print("{}", Options.usage_text()); return 0; }
    if options.version { print("fls {}\n", Options.FLS_VERSION); return 0; }
    if options.lol != .Off return Lol.run_lol(options.lol, options.snapshot, options.width);
    if options.tui || options.snapshot {
        if options.icons == .Never && !has_flag(args, "--icons") && !has_flag(args, "--no-icons")
            options.icons = .Always;
        return Tui.run_tui(&options, options.snapshot, options.keys);
    }
    return Cli.run_cli(&options);
}

Record :: struct {
    name: str;
    path: str;
    kind: str;
    size: s64;
    modified: s64;
    modified_valid: bool;
    depth: s64;
    git_x: u8;
    git_y: u8;
    link_target: str;
}

Record_List :: struct {
    items: [..]Record;
    error: str;
    code: s32;
}

release_records :: (list: *Record_List) {
    for item: list.items {
        item.name.free();
        item.path.free();
        item.link_target.free();
    }
    list.items.free();
    list.error.free();
    list.* = .{};
}

records :: (args: []const str) -> Record_List {
    mark := temp_mark();
    defer temp_rewind(mark);
    previous_scratch := context.temp_allocator;
    context.temp_allocator = default_temp_allocator();
    defer context.temp_allocator = previous_scratch;
    defer reset_globals();
    result: Record_List;
    options: Options.Options;
    defer Options.free_options(&options);
    if !valid_arguments(args) {
        result.code = 3;
        result.error = "ls arguments cannot contain NUL bytes".clone();
        return result;
    }
    parsed := Options.parse_options(args, &options);
    if !parsed.ok {
        result.code = 3;
        result.error = parsed.message.clone();
        return result;
    }
    if options.help || options.version || options.lol != .Off || options.tui || options.snapshot {
        result.code = 3;
        result.error = "help, version, animation and browser views produce terminal output, not file records".clone();
        return result;
    }
    if options.paths.count == 0 options.paths.push(".");
    scan: Size_Scan;
    if options.total_size scan = Size_Scan.start(terminal_capabilities().unwrap_or(.{}).interactive);
    defer scan.clear();
    files: [..]Entries.Entry;
    defer files.free();
    directories: [..]Entries.Entry;
    defer directories.free();
    for path: options.paths {
        entry := Entries.entry_make(path, path, options.filter.dereference);
        if !entry.stat_ok {
            result.code = 2;
            result.error = tprint("{}: {} (os error {})", path,
                Util.os_error_text(entry.stat_code), entry.stat_code).clone();
            entry.free();
            return result;
        }
        if options.absolute {
            if #pattern .Ok(resolved) = absolute(path) {
                entry.name.free();
                entry.name = resolved;
            }
        }
        if entry.is_dir && !options.list_dirs directories.push(entry);
        else files.push(entry);
    }
    Entries.sort_entries(files.view(), options.sort);
    if options.tree {
        roots: [..]Entries.Entry;
        defer roots.free();
        for *entry: files roots.push(value_take(entry));
        for *entry: directories roots.push(value_take(entry));
        Entries.sort_entries(roots.view(), options.sort);
        for *entry: roots {
            append_record(&result, entry, &options, 0, &scan);
            if entry.is_dir && !options.list_dirs {
                if !collect_directory(&result, entry.path, &options, 1, &scan) return result;
            }
        }
    } else {
        for *entry: files append_record(&result, entry, &options, 0, &scan);
        for entry: directories {
            if !collect_directory(&result, entry.path, &options, 0, &scan) return result;
        }
    }
    return result;
}

}

kind_name :: (entry: *Entries.Entry) -> str {
    if entry.meta.kind == {
    case .Directory; return "dir";
    case .Regular; return "file";
    case .Symlink; return "symlink";
    case .Fifo; return "fifo";
    case .Socket; return "socket";
    case .Block_Device; return "block";
    case .Character_Device; return "character";
    else; return "other";
    }
}

append_record :: (result: *Record_List, entry: *Entries.Entry, options: *Options.Options, depth: s64,
    scan: *Size_Scan) {
    record: Record;
    record.name = entry.name.clone();
    record.path = entry.path.clone();
    record.link_target = entry.link_target.clone();
    record.kind = kind_name(entry);
    record.size = entry.meta.size;
    record.modified = entry.meta.modified.seconds;
    record.modified_valid = entry.meta.modified.valid;
    record.depth = depth;
    if options.total_size && entry.meta.kind == .Directory && entry.name != ".."
        record.size = scan.measure(entry.path).unwrap_or(0);
    if options.git {
        directory := Util.parent_path(entry.path);
        if entry.is_dir && (entry.name == "." || entry.path == ".") directory = entry.path;
        if #pattern ?repo = Git.git_repo_for(directory) {
            x, y := Git.git_status_of(repo, entry.path, entry.is_dir);
            record.git_x = x;
            record.git_y = y;
        }
    }
    result.items.push(record);
}

collect_directory :: (result: *Record_List, path: str, options: *Options.Options, depth: s64,
    scan: *Size_Scan) -> bool {
    if options.tree && options.level >= 0 && depth > options.level return true;
    if depth > 1024 {
        result.code = 2;
        result.error = "directory recursion exceeded 1024 levels".clone();
        return false;
    }
    #pattern .Ok(found) := Entries.load_directory(path, &options.filter) else {
        result.code = 2;
        result.error = tprint("cannot read directory: {}", path).clone();
        return false;
    };
    entries := found;
    defer entries.free();
    Entries.sort_entries(entries.view(), options.sort);
    for *entry: entries {
        append_record(result, entry, options, depth, scan);
        if options.tree && entry.stat_ok && entry.meta.kind == .Directory &&
            entry.name != "." && entry.name != ".." {
            if !collect_directory(result, entry.path, options, depth + 1, scan) return false;
        }
    }
    if !options.tree && options.recurse && (options.level < 0 || depth + 1 < options.level) {
        for entry: entries {
            if entry.stat_ok && entry.meta.kind == .Directory && entry.name != "." && entry.name != ".." {
                if !collect_directory(result, entry.path, options, depth + 1, scan) return false;
            }
        }
    }
    return true;
}

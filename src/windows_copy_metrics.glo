//! Read-only measurements for a copy. Win32 directory listings already carry
//! file lengths, so the scan opens each directory once without opening files.
#import "Thread/Atomic";

#public Io_Sample :: struct {
    read: u64;
    written: u64;
    valid: bool;
}

#if OUT.os == .Windows {
    #import "Context";
    #import "Os";
    #import "Strings/Utf8";
    #import "Strings/Utf16";
    #import "File_System/Path";
    #import "Memory/Ownership";

    kernel :: #library,system "kernel32";
    // WIN32_FIND_DATAW's FILETIMEs are pairs of DWORDs, aligned to 4.
    Find_Data :: struct #c_call {
        attributes: u32;
        times: [6]u32;
        size_high: u32;
        size_low: u32;
        reparse_tag: u32;
        reserved: u32;
        name: [260]u16;
        alternate: [14]u16;
    }
    find_first :: (pattern: [*]const u16, level: s32, data: *Find_Data,
        search: s32, filter: ?*void, flags: u32) -> ssize #foreign kernel "FindFirstFileExW";
    find_next :: (handle: ssize, data: *Find_Data) -> s32 #foreign kernel "FindNextFileW";
    find_close :: (handle: ssize) -> s32 #foreign kernel "FindClose";
    last_error :: () -> u32 #foreign kernel "GetLastError";

    Io_Counters :: struct #c_call {
        read_operations: u64; write_operations: u64; other_operations: u64;
        read_bytes: u64; written_bytes: u64; other_bytes: u64;
    }
    current_process :: () -> ssize #foreign kernel "GetCurrentProcess";
    io_counters :: (process: ssize, counters: *Io_Counters) -> s32 #foreign kernel "GetProcessIoCounters";

    scan_directory :: (folder: str, pending: *[..]str, total: *s64, cancel: *Atomic(bool),
        scanned: *Atomic(s64)) -> bool {
        pattern := path_join(folder, "*");
        defer pattern.free();
        wide := pattern.cstring16_from_string();
        defer wide.free();
        data: Find_Data;
        // FindExInfoBasic avoids querying short names; LARGE_FETCH batches
        // records when the filesystem supports it.
        handle := find_first(wide.data, 1, &data, 0, null, 2);
        if handle == -1 return last_error() == 2; // No matches in an empty directory.
        defer _ := find_close(handle);
        while true {
            if cancel.load() return false;
            dot := data.name[0] == 46 && (data.name[1] == 0 || (data.name[1] == 46 && data.name[2] == 0));
            if !dot {
                _ := scanned.fetch_add(1);
                // Symbolic links and junctions set the name-surrogate bit.
                // Cloud files can have a reparse tag and still carry data.
                link := (data.attributes & 16#400) != 0 && (data.reparse_tag & 16#2000_0000) != 0;
                if !link {
                    if (data.attributes & 16#10) != 0 {
                        length: ssize;
                        while length < data.name.count && data.name[length] != 0 length += 1;
                        units: []const u16 = data.name[..length];
                        #pattern ?name := units.utf16_from_units() else { return false; };
                        #pattern ?text := name.to_string() else { return false; };
                        defer text.free();
                        pending.push(path_join(folder, text));
                    } else {
                        size := (cast(u64) data.size_high << 32) | cast(u64) data.size_low;
                        if size > cast(u64) (16#7fff_ffff_ffff_ffff - total.*) return false;
                        total.* += cast(s64) size;
                    }
                }
            }
            if find_next(handle, &data) == 0 return last_error() == 18; // ERROR_NO_MORE_FILES.
        }
        return false;
    }
}

// A cancelled or incomplete inventory never supplies a misleading total.
#public tree_size :: (source: str, cancel: *Atomic(bool), scanned: *Atomic(s64)) -> s64 {
    #if OUT.os == .Windows {
        if cancel.load() return -1;
        // GetFinalPathNameByHandleW supplies a fully qualified \\?\ path,
        // including the UNC form, for all descendant searches.
        root, code := os_canonical_path(source);
        if code != 0 { root.free(); return -1; }
        pending: [..]str;
        defer { for path: pending path.free(); pending.free(); }
        pending.push(root);
        scanned.store(1);
        total: s64;
        while pending.count > 0 {
            folder := array_pop_last(&pending);
            defer folder.free();
            #temp_scope {
                if cancel.load() || !scan_directory(folder, &pending, &total, cancel, scanned) return -1;
            }
        }
        return total;
    } else return -1;
}

#public io_sample :: () -> Io_Sample {
    #if OUT.os == .Windows {
        counters: Io_Counters;
        if io_counters(current_process(), &counters) != 0
            return .{ .read = counters.read_bytes, .written = counters.written_bytes, .valid = true };
    }
    return .{};
}

// Both directions of a transfer must have advanced. This keeps progress
// messages written to stderr from being counted as additional file data.
#public transferred :: (first: Io_Sample, current: Io_Sample) -> s64 {
    if !first.valid || !current.valid || current.read < first.read || current.written < first.written return -1;
    read := current.read - first.read;
    written := current.written - first.written;
    bytes := ifx read < written read else written;
    if bytes > 16#7fff_ffff_ffff_ffff return -1;
    return cast(s64) bytes;
}

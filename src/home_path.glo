//! Resolve a leading home component in paths supplied to the shell.
#import "Context";
#import "File_System/Path";
#import "Format";
#import "Process/Environment";
#import "String_Builder";
#import "Strings/Utf8";

#public {
VARIABLE :: ifx OUT.os == .Windows "USERPROFILE" else "HOME";

has_prefix :: (path: str) -> bool {
    return path.starts_with("~") && (path.count == 1 || path_is_separator(path[1]));
}

directory :: () -> str {
    return environment_get_or(VARIABLE, "").unwrap_or("");
}

unavailable :: () -> str {
    return tprint("cannot expand '~': {} is unset or empty", VARIABLE);
}

// The suffix starts with the original separator, or is empty for bare '~'.
from_home :: (suffix: str, allocator := context.allocator) -> ?str {
    home := directory();
    defer home.free();
    if home.count == 0 return null;
    if suffix.count > 0 && path_is_separator(home[home.count - 1]) suffix = suffix[1..];
    result := String_Builder.make_len_cap(0, home.count + suffix.count, allocator);
    result.write_string(home);
    #if OUT.os == .Windows {
        // Verbatim Windows paths also require native separators in the suffix.
        for byte: suffix.bytes() result.write_byte(ifx byte == #char "/" #char "\\" else byte);
    } else result.write_string(suffix);
    return ?result.into_string();
}

// Ordinary paths borrow their input. Expanded paths live in the supplied arena.
resolve :: (path: str, allocator: Allocator) -> ?str {
    if !has_prefix(path) return ?path;
    return from_home(path[1..], allocator);
}
}

#import "Process";
#import "Process/Command";
#import "Process/Pipe";
#import "File_System/File";
#import "File_System/Temporary";
#import "Strings/Utf8";
#import "Strings/Memory";
#import "Format";

#public {

Invocation :: struct {
    args: []const str;
}

// All strings and the status array belong to this outcome. Release once.
// A status of -1 means that a stage could not be started or observed.
Outcome :: struct {
    code: s64;
    signal: s64;
    stdout: str;
    stderr: str;
    error: str;
    statuses: [..]s64;
}

release :: (out: *Outcome) {
    out.stdout.free();
    out.stderr.free();
    out.error.free();
    out.statuses.free();
    out.* = .{};
}

// Start every stage before waiting. Pipes carry bytes directly between
// children; temporary files allow capture of both output streams without
// depending on pipe-buffer capacity or allocating a reader thread.
execute :: (
    commands: []const Invocation,
    input: str = "",
    has_input: bool = false,
    capture: bool = false,
) -> Outcome {
    out: Outcome;
    if commands.count == 0 return out;
    for i: 0..commands.count {
        out.statuses.push(-1);
        args := commands[i].args;
        if args.count == 0 || args[0].count == 0 {
            out.code = 2;
            out.error = "a command requires a nonempty executable name".clone();
            return out;
        }
        for arg: args {
            for byte: arg.bytes() {
                if byte == 0 {
                    out.code = 2;
                    out.error = "command arguments cannot contain NUL bytes".clone();
                    return out;
                }
            }
        }
    }

    input_file: Temporary_File;
    defer input_file.free();
    output_file: Temporary_File;
    defer output_file.free();
    error_file: Temporary_File;
    defer error_file.free();
    if has_input {
        if Temporary_File.create_temporary_file("", "lush-stdin-") == {
        case .Ok(value); input_file = value;
        case .Err(error);
            out.code = 1;
            out.error = tprint("cannot create pipeline input: {}", error.kind).clone();
            return out;
        }
        written: ssize = 0;
        while written < input.count {
            if input_file.file.write(input[written..]) == {
            case .Ok(count);
                if count <= 0 {
                    out.code = 1;
                    out.error = "cannot write pipeline input".clone();
                    return out;
                }
                written += count;
            case .Err(error);
                out.code = 1;
                out.error = tprint("cannot write pipeline input: {}", error.kind).clone();
                return out;
            }
        }
        if #pattern .Err(error) = input_file.file.seek(0) {
            out.code = 1;
            out.error = tprint("cannot rewind pipeline input: {}", error.kind).clone();
            return out;
        }
    }
    if capture {
        if Temporary_File.create_temporary_file("", "lush-stdout-") == {
        case .Ok(value); output_file = value;
        case .Err(error);
            out.code = 1;
            out.error = tprint("cannot capture stdout: {}", error.kind).clone();
            return out;
        }
        if Temporary_File.create_temporary_file("", "lush-stderr-") == {
        case .Ok(value); error_file = value;
        case .Err(error);
            out.code = 1;
            out.error = tprint("cannot capture stderr: {}", error.kind).clone();
            return out;
        }
    }

    pipes: [..]Process_Pipe;
    children: [..]Child;
    defer cleanup(&children, &pipes);
    for i: 1..commands.count {
        if process_pipe_create() == {
        case .Ok(pipe); pipes.push(pipe);
        case .Err(error);
            out.code = 1;
            out.error = tprint("cannot create pipeline: {}", error.kind).clone();
            return out;
        }
    }
    for i: 0..commands.count {
        args := commands[i].args;
        command := Command.command_make(args[0], args[1..]);
        defer command.destroy();
        if i > 0 command.redirect_stdin(&pipes[i - 1].read_end);
        else if has_input command.redirect_stdin(&input_file.file);
        if i + 1 < commands.count command.redirect_stdout(&pipes[i].write_end);
        else if capture command.redirect_stdout(&output_file.file);
        if capture command.redirect_stderr(&error_file.file);
        if command.spawn() == {
        case .Ok(child); children.push(child);
        case .Err(error);
            out.code = 126;
            if error.kind == .Not_Found out.code = 127;
            out.statuses[i] = out.code;
            out.error = tprint("{}: {}", args[0], error.kind.reason()).clone();
            return out;
        }
    }
    // Without closing these copies here, downstream children would never
    // observe EOF, even after their producer exits.
    close_pipes(&pipes);
    for i: 0..children.count {
        if children[i].wait() == {
        case .Ok(waited);
            code := waited.status.code;
            if waited.status.signalled code = 128 + waited.status.signal;
            out.statuses[i] = code;
            if code != 0 {
                out.code = code;
                out.signal = waited.status.signal;
            }
        case .Err(error);
            out.code = 1;
            out.error = tprint("cannot wait for command: {}", error.kind.reason()).clone();
            return out;
        }
    }
    if capture {
        if #pattern .Err(error) = output_file.file.seek(0) {
            out.code = 1;
            out.error = tprint("cannot rewind captured stdout: {}", error.kind).clone();
            return out;
        }
        if output_file.file.read() == {
        case .Ok(value); out.stdout = value;
        case .Err(error);
            out.code = 1;
            out.error = tprint("cannot read captured stdout: {}", error.kind).clone();
            return out;
        }
        if #pattern .Err(error) = error_file.file.seek(0) {
            out.code = 1;
            out.error = tprint("cannot rewind captured stderr: {}", error.kind).clone();
            return out;
        }
        if error_file.file.read() == {
        case .Ok(value); out.stderr = value;
        case .Err(error);
            out.code = 1;
            out.error = tprint("cannot read captured stderr: {}", error.kind).clone();
            return out;
        }
    }
    return out;
}

}

#private {

close_pipes :: (pipes: *[..]Process_Pipe) {
    for i: 0..pipes.*.count {
        if pipes.*[i].read_end.valid _ := pipes.*[i].read_end.close();
        if pipes.*[i].write_end.valid _ := pipes.*[i].write_end.close();
    }
}

cleanup :: (children: *[..]Child, pipes: *[..]Process_Pipe) {
    close_pipes(pipes);
    // A spawn/wait error must not leave a blocked producer behind.
    for i: 0..children.*.count {
        if children.*[i].valid _ := children.*[i].kill();
    }
    for i: 0..children.*.count {
        if children.*[i].valid {
            _ := children.*[i].wait();
            if children.*[i].valid _ := children.*[i].close();
        }
    }
    children.free();
    pipes.free();
}

}
